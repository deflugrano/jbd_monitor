# ══════════════════════════════════════════════════════════
#  JBD BMS Monitor — Настройки
# ══════════════════════════════════════════════════════════

# MAC-адрес вашей BMS (узнайте через: sudo bluetoothctl → scan on)
BMS_MAC_ADDRESS=AA:BB:CC:11:22:33

# Токен Telegram бота (получите у @BotFather)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Публичный HTTPS URL (подставится автоматически из cloudflared)
WEBAPP_URL=https://your-url.trycloudflare.com

# Интервал опроса BMS в секундах
POLL_INTERVAL=3
